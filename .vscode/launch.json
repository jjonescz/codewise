{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Codewise on Roslyn",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "C:\\roslyn-3"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/dist/**/*.js",
        "${workspaceFolder}/packages/vscode-extension/dist/**/*.cjs"
      ],
      "preLaunchTask": "build-codewise"
    },
    {
      "name": "Run Codewise for Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx vscode-test-web --browserType=chromium --extensionDevelopmentPath=\"${workspaceFolder}\\packages\\vscode-extension\" \"${input:webWorkspacePath}\"",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-codewise"
    }
  ],
  "inputs": [
    {
      "id": "webWorkspacePath",
      "type": "promptString",
      "description": "Workspace folder to open in VS Code for the Web",
      "default": "C:\\roslyn-3"
    }
  ]
}

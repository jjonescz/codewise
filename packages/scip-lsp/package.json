{
  "name": "@codewise/scip-lsp",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./index-source": {
      "types": "./dist/index-source.d.ts",
      "import": "./dist/index-source.js"
    },
    "./workspace-uri-mapper": {
      "types": "./dist/workspace-uri-mapper.d.ts",
      "import": "./dist/workspace-uri-mapper.js"
    }
  },
  "bin": {
    "codewise-scip-lsp": "./dist/node.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codewise/scip-core": "0.0.1",
    "vscode-languageserver": "10.1.0",
    "vscode-uri": "3.2.0"
  }
}

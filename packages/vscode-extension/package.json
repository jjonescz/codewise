{
  "name": "codewise-lsp",
  "displayName": "Codewise",
  "description": "Precomputed code intelligence and navigation for VS Code.",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "publisher": "jjones",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjonescz/codewise.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "onCommand:codewise.selectIndex",
    "onCommand:codewise.restartServer"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codewise.selectIndex",
        "title": "Codewise: Select Index File"
      },
      {
        "command": "codewise.restartServer",
        "title": "Codewise: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Codewise",
      "properties": {
        "codewise.indexPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute path or workspace URI to the code intelligence index. When empty, Codewise uses .scip/index.scip or downloads the matching workflow artifact for a Roslyn workspace."
        },
        "codewise.roslynCommit": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "pattern": "^[a-fA-F0-9]{40}$|^$",
          "patternErrorMessage": "Enter a full 40-character Git commit SHA or leave the setting empty.",
          "description": "Exact Roslyn commit whose hosted index artifact should be used in VS Code for the Web. The desktop extension determines this with Git."
        }
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@codewise/scip-lsp": "0.0.1",
    "@types/vscode": "^1.100.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "vscode-languageclient": "10.1.0"
  }
}

{
  "name": "codewise-scip",
  "displayName": "Codewise SCIP",
  "description": "SCIP-backed navigation through a portable language server.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "publisher": "codewise",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjonescz/codewise.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "onCommand:codewise.scip.selectIndex",
    "onCommand:codewise.scip.restartServer"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codewise.scip.selectIndex",
        "title": "SCIP: Select Index File"
      },
      {
        "command": "codewise.scip.restartServer",
        "title": "SCIP: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Codewise SCIP",
      "properties": {
        "codewise.scip.indexPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute path or workspace URI to index.scip. When empty, the extension uses .scip/index.scip or downloads the matching workflow artifact for a Roslyn workspace."
        },
        "codewise.scip.roslynCommit": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "pattern": "^[a-fA-F0-9]{40}$|^$",
          "patternErrorMessage": "Enter a full 40-character Git commit SHA or leave the setting empty.",
          "description": "Exact Roslyn commit whose hosted SCIP artifact should be used in VS Code for the Web. The desktop extension determines this with Git."
        }
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@codewise/scip-lsp": "0.0.1",
    "@types/vscode": "^1.100.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "vscode-languageclient": "10.1.0"
  }
}
